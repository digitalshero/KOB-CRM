[Unit]
Description=KOB CRM Lead Inbox 24h Retargeting (batch mode) - Node replacement for Supabase send_lead_inbox_7day_retargeting()
After=network.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/data/kob-crm/current/backend
EnvironmentFile=/data/kob-crm/shared/kob-staging.env
ExecStart=/data/kob-crm/runtime/node22/bin/node dist/workers/leadInboxRetargeting.js

# No [Install] WantedBy here deliberately: only ever started by the timer.
