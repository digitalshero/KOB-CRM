# Backend Server Configuration
PORT=3001
NODE_ENV=development

# Frontend Origins (comma-separated or single)
FRONTEND_URL=http://localhost:5173

# Supabase Local/Production Credentials (Placeholders only - do not commit real secrets)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Not used by backend/src (direct-RDS connection vars are below instead).
DATABASE_URL=

# --- Direct PostgreSQL/RDS connection (Stage 10B, additive — unused until an
# endpoint migrates in Stage 10C+). Discrete PG* vars only; no DATABASE_URL,
# so the password never needs URL-encoding and can't leak via a connection
# string in logs. Placeholders only - do not commit real secrets.
PGHOST=
PGPORT=5432
PGDATABASE=kob_staging
PGUSER=kob_app_user
PGPASSWORD=
# Path to the RDS CA bundle (e.g. AWS's global-bundle.pem) used to verify
# the server certificate. SSL is always verified; there is no insecure mode.
DATABASE_SSL_CA_PATH=

# Which data backend endpoints use. Must stay "supabase" until an endpoint
# is explicitly migrated to the direct-RDS path (Stage 10C+). Nothing reads
# this value yet.
DATA_BACKEND=supabase

# --- Gallabox/email outbound worker kill switch (Stage 10I-F, additive —
# no worker exists in this codebase yet). Must stay false until a reviewed
# outbound worker is actually implemented and approved to run.
OUTBOUND_ENABLED=false

# --- AWS staging values (kob_staging on RDS). Copy this file to .env on the
# EC2 host and fill in PGHOST/PGPASSWORD/DATABASE_SSL_CA_PATH from the
# server's own protected env store — never commit real values here or
# anywhere in the repo. See infra/deployment/README.md for the systemd
# env-file setup this maps onto.
#   PGHOST=shero-india-new-postgres.cr4cwg80sogd.ap-south-1.rds.amazonaws.com
#   PGPORT=5432
#   PGDATABASE=kob_staging
#   PGUSER=kob_app_user
#   PGPASSWORD=<set only in the server's protected env file, never in git>
#   DATABASE_SSL_CA_PATH=/etc/kob-backend/rds-ca/global-bundle.pem
#   DATA_BACKEND=rds
#   OUTBOUND_ENABLED=false
#   NODE_ENV=production
# Supabase Auth vars (SUPABASE_URL / SUPABASE_PUBLISHABLE_KEY /
# SUPABASE_SERVICE_ROLE_KEY above) remain required in staging — Auth is not
# migrated.
